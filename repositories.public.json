{
  "schema": "goreecloud-public-repository-registry/v1",
  "observedAt": "2026-09-25",
  "authority": {
    "source": "GitHub repository metadata",
    "owner": "GoreeCloud",
    "scope": "Public repository presence, default branch, visibility, and archive state only",
    "lifecycleAuthority": false,
    "productionAuthority": false,
    "platformAcceptanceAuthority": false
  },
  "privacyBoundary": {
    "publicOnly": true,
    "privateRepositoryNamesIncluded": false,
    "note": "Private repository identities are intentionally not centralized in this public registry. Public product and platform names may still appear in GoreeCloud documentation."
  },
  "defaults": {
    "visibility": "public",
    "archived": false,
    "defaultBranch": "main"
  },
  "defaultBranchOverrides": {
    "GoreeCloud/goreecloud-dns": "master"
  },
  "notes": [
    "Repository presence does not imply application completeness, lifecycle maturity, production approval, or completed platform integration.",
    "Canonical project specifications, repository-local release evidence, acceptance records, and applicable GoreeCloud instructions, standards, and policies remain authoritative for lifecycle and acceptance state.",
    "Contract 2.0 lifecycle migration is evidence-based; repository inventory changes must not be used to mass-promote or mechanically translate lifecycle values."
  ],
