{
  "schema": "goreecloud-public-repository-registry/v1",
  "observedAt": "2026-09-02",
  "authority": {
    "source": "GitHub repository metadata",
    "owner": "GoreeCloud",
    "scope": "Public repository presence, default branch, visibility, and archive state only",
    "lifecycleAuthority": false,
    "productionAuthority": false,
    "platformAcceptanceAuthority": false
  },
  "privacyBoundary": {
    "publicOnly": true,
    "privateRepositoryNamesIncluded": false,
    "note": "Private repository identities are intentionally not centralized in this public registry. Public product and platform names may still appear in GoreeCloud documentation."
  },
  "defaults": {
    "visibility": "public",
    "archived": false,
    "defaultBranch": "main"
  },
  "defaultBranchOverrides": {
    "GoreeCloud/goreecloud-backup": "master",
    "GoreeCloud/goreecloud-dns": "master",
    "GoreeCloud/goreecloud-search": "master"
  },
  "notes": [
    "Repository presence does not imply application completeness, Stable status, production approval, or completed platform integration.",
    "Canonical project specifications, repository-local release evidence, and applicable GoreeCloud instructions, standards, and policies remain authoritative for lifecycle and acceptance state."
  ],
  "repositories": [
