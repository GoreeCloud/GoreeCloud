{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.goreecloud.com/platform/goreecloud.platform.schema.json",
  "title": "GoreeCloud Platform Contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "component", "api", "glaze_ui", "platform_systems", "mesh", "health", "recovery", "data_portability", "external_dependencies", "compatibility", "conformance", "evidence"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "product_name", "kind", "repository", "lifecycle", "version", "supported_platforms", "user_facing"],
      "properties": {
        "id": {"type": "string", "pattern": "^goreecloud\\.[a-z0-9][a-z0-9.-]*$"},
        "product_name": {"type": "string", "minLength": 1},
        "kind": {"enum": ["application", "service", "library", "website", "platform-component"]},
        "repository": {"type": "string", "pattern": "^GoreeCloud/[A-Za-z0-9._-]+$"},
        "lifecycle": {"enum": ["Concept", "Experimental", "Development", "Release Candidate", "Stable", "Deprecated", "Retired"]},
        "version": {"type": "string", "minLength": 1},
        "supported_platforms": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "user_facing": {"type": "boolean"}
      }
    },
    "api": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "endpoints"],
      "properties": {
        "version": {"type": ["string", "null"]},
        "endpoints": {"type": "array", "items": {"$ref": "#/$defs/endpoint"}}
      }
    },
    "glaze_ui": {
      "type": "object",
      "additionalProperties": false,
      "required": ["applicable", "required_version", "implemented_version", "migration_status", "evidence"],
      "properties": {
        "applicable": {"type": "boolean"},
        "required_version": {"const": "2.2.0"},
        "implemented_version": {"type": ["string", "null"]},
        "migration_status": {"enum": ["not_applicable", "current", "required", "in_progress", "blocked", "unverified"]},
        "evidence": {"$ref": "#/$defs/evidenceRefs"}
      }
    },
    "platform_systems": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manager", "identity", "wardveil_security", "privacy_shield", "everkeep", "mesh", "glaze_ui"],
      "properties": {
        "manager": {"$ref": "#/$defs/systemEvaluation"},
        "identity": {"$ref": "#/$defs/systemEvaluation"},
        "wardveil_security": {"$ref": "#/$defs/systemEvaluation"},
        "privacy_shield": {"$ref": "#/$defs/systemEvaluation"},
        "everkeep": {"$ref": "#/$defs/systemEvaluation"},
        "mesh": {"$ref": "#/$defs/systemEvaluation"},
        "glaze_ui": {"$ref": "#/$defs/systemEvaluation"}
      }
    },
    "mesh": {
      "type": "object",
      "additionalProperties": false,
      "required": ["registration", "capabilities", "dependencies", "published_events", "consumed_events", "evidence"],
      "properties": {
        "registration": {"enum": ["registered", "required", "not_applicable", "unverified"]},
        "capabilities": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "dependencies": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "published_events": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "consumed_events": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "evidence": {"$ref": "#/$defs/evidenceRefs"}
      }
    },
    "health": {
      "type": "object",
      "additionalProperties": false,
      "required": ["liveness", "readiness"],
      "properties": {
        "liveness": {"type": "array", "items": {"$ref": "#/$defs/interface"}},
        "readiness": {"type": "array", "items": {"$ref": "#/$defs/interface"}}
      }
    },
    "recovery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["backup_required", "backup_status", "restore_required", "restore_status", "last_verified_restore", "recovery_dependencies", "documentation", "evidence"],
      "properties": {
        "backup_required": {"type": "boolean"},
        "backup_status": {"$ref": "#/$defs/verificationState"},
        "restore_required": {"type": "boolean"},
        "restore_status": {"$ref": "#/$defs/verificationState"},
        "last_verified_restore": {"type": ["string", "null"], "format": "date-time"},
        "recovery_dependencies": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "documentation": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "evidence": {"$ref": "#/$defs/evidenceRefs"}
      }
    },
    "data_portability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["export_capability", "export_formats", "last_export_validation", "portability_requirements", "evidence"],
      "properties": {
        "export_capability": {"$ref": "#/$defs/verificationState"},
        "export_formats": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "last_export_validation": {"type": ["string", "null"], "format": "date-time"},
        "portability_requirements": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "evidence": {"$ref": "#/$defs/evidenceRefs"}
      }
    },
    "external_dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "purpose", "required", "compatibility"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "purpose": {"type": "string", "minLength": 1},
          "required": {"type": "boolean"},
          "compatibility": {"type": "string", "minLength": 1}
        }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform_releases", "api_requirements", "schema_requirements", "component_requirements"],
      "properties": {
        "platform_releases": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "api_requirements": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "schema_requirements": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "component_requirements": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "conformance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["declared_state", "stable_eligible", "checks"],
      "properties": {
        "declared_state": {"enum": ["conformant", "nonconformant", "migration_required", "blocked"]},
        "stable_eligible": {"type": "boolean"},
        "checks": {"type": "array", "minItems": 17, "items": {"$ref": "#/$defs/conformanceCheck"}}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["acceptance", "release"],
      "properties": {
        "acceptance": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
        "release": {"type": "array", "items": {"$ref": "#/$defs/evidence"}}
      }
    }
  },
  "$defs": {
    "evidenceRefs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "verificationState": {"enum": ["verified", "implemented_unverified", "required_missing", "not_applicable", "unknown"]},
    "systemEvaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "justification", "evidence"],
      "properties": {
        "status": {"enum": ["Applicable — Conformant", "Applicable — Migration Required", "Applicable — Blocked", "Applicable — Nonconformant", "Not Applicable — Justified"]},
        "justification": {"type": "string", "minLength": 1},
        "evidence": {"$ref": "#/$defs/evidenceRefs"}
      }
    },
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "method", "path", "purpose"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "method": {"enum": ["GET", "POST", "PUT", "PATCH", "DELETE", "HEAD", "OPTIONS"]},
        "path": {"type": "string", "minLength": 1},
        "purpose": {"type": "string", "minLength": 1}
      }
    },
    "interface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "path"],
      "properties": {
        "method": {"enum": ["GET", "POST", "HEAD"]},
        "path": {"type": "string", "minLength": 1}
      }
    },
    "conformanceCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "mandatory", "status", "evidence"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "mandatory": {"type": "boolean"},
        "status": {"enum": ["pass", "fail", "pending", "not_applicable"]},
        "evidence": {"$ref": "#/$defs/evidenceRefs"},
        "note": {"type": "string"}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "location", "producer", "description"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
        "kind": {"enum": ["source", "automated_test", "integration_test", "runtime", "rendered", "accessibility", "recovery", "security", "privacy", "documentation", "release", "deployment"]},
        "location": {"type": "string", "minLength": 1},
        "revision": {"type": ["string", "null"]},
        "observed_at": {"type": ["string", "null"], "format": "date-time"},
        "producer": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1}
      }
    }
  }
}
