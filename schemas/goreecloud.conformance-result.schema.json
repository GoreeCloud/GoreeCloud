{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goreecloud.com/schemas/goreecloud.conformance-result.schema.json",
  "title": "GoreeCloud Platform Conformance Result",
  "description": "Computed Platform Contract 2.0 repository conformance result bound to exact repository and evaluator revisions. Lifecycle, flags, deployment, qualification, and eligibility remain separate controls; aggregators may present this result but do not acquire authority over producer-owned facts.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "component",
    "repository",
    "manifest_schema_version",
    "evaluated_revision",
    "evaluator_repository",
    "evaluator_revision",
    "evaluated_at",
    "lifecycle",
    "declared_conformance",
    "computed_conformance",
    "lifecycle_flags",
    "deployment_state",
    "qualification_state",
    "next_gate",
    "candidate_source_revision",
    "last_lifecycle_transition",
    "lifecycle_evidence",
    "anchor_eligible",
    "checks",
    "blockers",
    "authority"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "component": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "repository": {
      "type": "string",
      "pattern": "^GoreeCloud/[A-Za-z0-9._-]+$"
    },
    "manifest_schema_version": {
      "const": "2.0"
    },
    "evaluated_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "evaluator_repository": {
      "const": "GoreeCloud/GoreeCloud"
    },
    "evaluator_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "evaluated_at": {
      "type": "string",
      "format": "date-time"
    },
    "lifecycle": {
      "enum": [
        "seed",
        "lab",
        "forge",
        "weave",
        "seal",
        "anchor",
        "sunset",
        "archive"
      ]
    },
    "declared_conformance": {
      "enum": [
        "conformant",
        "nonconformant",
        "unverified"
      ]
    },
    "computed_conformance": {
      "enum": [
        "conformant",
        "nonconformant",
        "unverified"
      ]
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "category",
          "result",
          "evidence",
          "message"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "enum": [
              "platform-system",
              "compatibility",
              "evidence",
              "release"
            ]
          },
          "result": {
            "enum": [
              "passed",
              "failed"
            ]
          },
          "declared_result": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "message": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "blockers": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "declaration_owner",
        "aggregation_role",
        "aggregators_may_transfer_authority",
        "notes"
      ],
      "properties": {
        "declaration_owner": {
          "type": "string",
          "pattern": "^GoreeCloud/[A-Za-z0-9._-]+$"
        },
        "aggregation_role": {
          "const": "read-only"
        },
        "aggregators_may_transfer_authority": {
          "const": false
        },
        "notes": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "lifecycle_flags": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "blocked",
          "security-hold",
          "privacy-hold",
          "recovery-hold",
          "migration-required",
          "superseded"
        ]
      }
    },
    "deployment_state": {
      "enum": [
        "development",
        "test",
        "staging",
        "acceptance",
        "controlled-production",
        "normal-production",
        "recovery",
        "other"
      ]
    },
    "qualification_state": {
      "enum": [
        "not-started",
        "in-progress",
        "blocked",
        "passed",
        "not-applicable"
      ]
    },
    "next_gate": {
      "enum": [
        "seed",
        "lab",
        "forge",
        "weave",
        "seal",
        "anchor",
        "sunset",
        "archive",
        null
      ]
    },
    "candidate_source_revision": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{40}$"
    },
    "last_lifecycle_transition": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "lifecycle_evidence": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "anchor_eligible": {
      "type": "boolean"
    }
  }
}
